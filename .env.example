ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=  # Optional: proxy URL, leave empty for official API
PLANNER_MODEL=claude-sonnet-4-6
GENERATOR_MODEL=claude-sonnet-4-6
EVALUATOR_MODEL=claude-sonnet-4-6
EVALUATOR_VISION_MODEL=claude-sonnet-4-6
EVALUATOR_VISION_API_KEY=  # Optional: defaults to ANTHROPIC_API_KEY when empty
EVALUATOR_VISION_BASE_URL=  # Optional: defaults to ANTHROPIC_BASE_URL when empty
EVALUATOR_VISION_ENDPOINT_TYPE=anthropic  # anthropic | openai
EVALUATOR_VISION_MAX_TOKENS=1200
SDK_MAX_BUFFER_SIZE=8388608
DESIGN_MODE=text-only  # text-only | image-first
DESIGN_IMAGE_API_KEY=  # Optional: required for live image-first generation
DESIGN_IMAGE_BASE_URL=https://right.codes/draw
DESIGN_IMAGE_MODEL=gpt-image-2
DESIGN_IMAGE_SIZE=1024x1024
DESIGN_IMAGE_TIMEOUT_SECONDS=180
