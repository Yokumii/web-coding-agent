ANTHROPIC_API_KEY=sk-...
ANTHROPIC_BASE_URL=  # Optional: proxy URL, leave empty for official API

PLANNER_MODEL=claude-sonnet-4-6
GENERATOR_MODEL=claude-sonnet-4-6
EVALUATOR_MODEL=claude-sonnet-4-6
EVALUATOR_VISION_MODEL=claude-sonnet-4-6
PLANNER_SCOPE_MODE=query-aligned  # query-aligned | expansive-data

# Optional design stage. Set DESIGN_MODE=image-first to enable plan -> design -> build -> evaluate.
DESIGN_MODE=text-only  # text-only | image-first
DESIGN_IMAGE_API_KEY=  # Optional: required only when auto-generating approved_concept/background_ui images
DESIGN_IMAGE_BASE_URL=https://right.codes/draw
DESIGN_IMAGE_MODEL=gpt-image-2
DESIGN_IMAGE_SIZE=1024x1024
DESIGN_IMAGE_TIMEOUT_SECONDS=180

EVALUATOR_VISION_API_KEY=  # Optional: defaults to ANTHROPIC_API_KEY when empty
EVALUATOR_VISION_BASE_URL=  # Optional: defaults to ANTHROPIC_BASE_URL when empty
EVALUATOR_VISION_ENDPOINT_TYPE=anthropic  # anthropic | openai
EVALUATOR_VISION_MAX_TOKENS=1200
EVALUATOR_VISION_MAX_RETRIES=3
EVALUATOR_VISION_RETRY_BASE_DELAY=2.0

MAX_BUDGET_USD=150
MAX_ROUNDS=3
MAX_DELIVERABLES_PER_SPRINT=5
MAX_EXIT_CRITERIA_PER_SPRINT=5
FRONTEND_PORT=5173
PLAYWRIGHT_HEADLESS=false
MINIMALITY_GUARD_ENABLED=true
MINIMALITY_MAX_ATOMS=12
MINIMALITY_ORACLE_TIMEOUT_SECONDS=240
MINIMAL_PATH_GUIDANCE_ENABLED=true
MINIMAL_PATH_MAX_PATCH_LINES=120
MINIMAL_PATH_MAX_TOUCHED_FILES=3
SDK_MAX_BUFFER_SIZE=8388608
OPENAI_RECENT_MESSAGES=18
OPENAI_TOOL_RESULT_CHARS=8000
GENERATOR_MAX_TURNS=50
EVALUATOR_MAX_TURNS=30
